# Copy to .env and fill in. Never commit the resulting .env file.

# Shared secret expected in the X-Auth-Token request header. Required.
# Generate one with: openssl rand -hex 32
WOL_AUTH_TOKEN=replace-with-a-long-random-secret

# Default target MAC address. Optional if callers always supply "mac" in the
# request body. Accepts aa:bb:cc:dd:ee:ff, AA-BB-CC-DD-EE-FF or aabbccddeeff.
WOL_TARGET_MAC=aa:bb:cc:dd:ee:ff

# Allow callers to override the target via {"mac": "..."} in the request body.
WOL_ALLOW_BODY_MAC=true

# Broadcast destination for the magic packet. The all-networks broadcast works
# on most setups; a subnet-directed broadcast (e.g. 192.0.2.255) is an option
# when the host has several interfaces.
WOL_BROADCAST_ADDRESS=255.255.255.255

# UDP port the magic packet is sent to. 9 (discard) and 7 (echo) are typical.
WOL_PORT=9

# HTTP listener. With network_mode: host this binds directly on the host.
WOL_LISTEN_HOST=0.0.0.0
WOL_LISTEN_PORT=8099

# DEBUG, INFO, WARNING or ERROR.
WOL_LOG_LEVEL=INFO

# User and group the relay runs as (Unraid: 99 and 100), and the time zone
# for log time stamps, e.g. Europe/Berlin. Defaults: 1000, 1000, Etc/UTC.
PUID=1000
PGID=1000
TZ=Etc/UTC
